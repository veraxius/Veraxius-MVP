generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String                    @id @default(uuid())
  email        String                    @unique
  password     String
  googleId     String?                   @unique
  name         String?
  profilePictureUrl String?
  resetToken       String?
  resetTokenExpiry DateTime?
  emailVerified           Boolean   @default(false)
  verificationCode        String?
  verificationCodeExpiry  DateTime?
  created_at   DateTime                  @default(now())
  lastActiveAt DateTime?
  aimConfidence Decimal?                 @db.Decimal(3, 2)
  aimDomainPrimary String?
  participants ConversationParticipant[]
  messages     Message[]
  // AIM fields
  aimScore     Float                     @default(0.5)
  aimStatus    String                    @default("stable") // increasing | decreasing | decaying
  // AIM relations
  aimEvents                 AimEvent[]
  aimScoreHistory           AimScoreHistory[]
  aimChallengesAsTarget     AimChallenge[]           @relation("TargetUser")
  aimChallengesAsChallenger AimChallenge[]           @relation("ChallengerUser")
  aimOutcomes               AimOutcome[]
  aimConsistency            AimConsistency?
  aimDomainScores           AimDomainScore[]
  aimFlags                  AimFlag[]
  // Domain system relations
  postDomains              PostDomain[]
  userDomainScores         UserDomainScore[]
  domainAimEvents          DomainAimEvent[]          @relation("DomainEventOwner")
  domainAimEventsAsVoter   DomainAimEvent[]          @relation("DomainEventVoter")
  // Evidence relations
  evidenceUploads          Evidence[]
  // MVP5 — AIM Trust & Authority Layer relation
  aimMvp5Entities           Entity[]
}

model Conversation {
  id           String                    @id @default(cuid())
  created_at   DateTime                  @default(now())
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  content        String
  imageUrl       String?
  status         String       @default("sent") // sent | delivered | read
  created_at     DateTime     @default(now())
  conversationId String
  senderId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])
}

// AIM MODELS
model AimEvent {
  id        String   @id @default(uuid())
  userId    String
  eventType String
  signal    String?
  delta     Float
  weight    Float       @default(1)
  domain    String?
  contextWeight Float   @default(1)
  metadata  Json?
  createdAt DateTime @default(now())
  // Tamper-evidence hash (SHA-256 of the event's canonical fields), computed
  // lazily the first time a Trust Receipt is generated for this event — not
  // set at write time, so this never touches the live scoring engine.
  contentHash String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence Evidence[]

  @@index([userId])
}

model AimScoreHistory {
  id           String   @id @default(uuid())
  userId       String
  score        Float
  context      String?
  explanations Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AimChallenge {
  id              String   @id @default(uuid())
  targetUserId    String
  challengerId    String
  reason          String
  severity        Int
  status          String   @default("pending") // pending | resolved | rejected
  resolution      String?  // positive | negative
  impact          Float?
  createdAt       DateTime @default(now())
  // Purely descriptive context for the new Challenge wizard (MVP4) — which
  // specific AimEvent/DomainAimEvent this dispute is about, if any. Not a
  // relation on purpose (keeps this additive and avoids coupling to either
  // event table's id space); never read by openChallenge/resolveChallenge.
  contextEventId   String?
  contextEventKind String? // "event" | "domain-event"

  targetUser User @relation("TargetUser", fields: [targetUserId], references: [id])
  challenger User @relation("ChallengerUser", fields: [challengerId], references: [id])
  evidence   Evidence[]

  @@index([targetUserId])
}

model AimOutcome {
  userId        String
  interactionId String
  quality       Decimal  @db.Decimal(3, 2)
  verifiedBy    String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, interactionId])
  @@index([userId])
}

model AimConsistency {
  userId       String   @id
  breakCount   Int      @default(0)
  matchCount   Int      @default(0)
  lastSnapshot Json?
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AimDomainScore {
  userId           String
  domain           String
  score            Float      @default(0)
  confidence       Float      @default(0)
  interactionCount Int        @default(0)
  updatedAt        DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, domain])
  @@index([userId])
}

model AimFlag {
  userId    String
  flagType  String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, flagType, createdAt])
  @@index([userId])
}

// COMMUNITY FEED MODELS
model Post {
  id           Int            @id @default(autoincrement())
  userId       String
  userName     String
  userVerified Boolean        @default(false)
  content      String
  imageUrl     String?
  createdAt    DateTime       @default(now())
  reactions    PostReaction[]
  comments     Comment[]
  // Domain system relations
  postDomains     PostDomain[]
  domainAimEvents DomainAimEvent[]
}

model PostReaction {
  id      Int    @id @default(autoincrement())
  postId  Int
  userId  String
  type    String
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, type])
}

model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    String
  userName  String
  content   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// DOMAIN SYSTEM MODELS

// Stores the domain classification for each post (primary + optional secondary)
model PostDomain {
  id              String   @id @default(uuid())
  postId          Int
  userId          String
  domainName      String
  confidenceScore Float    @default(0)
  isPrimary       Boolean  @default(true)
  rawKeywordScore Float    @default(0)
  classifiedAt    DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, isPrimary])
  @@index([userId])
  @@index([domainName])
}

// Per-user, per-domain AIM score
model UserDomainScore {
  id                   String    @id @default(uuid())
  userId               String
  domainName           String
  domainAimScore       Float     @default(0.50)
  domainConfidence     Float     @default(0)
  interactionCount     Int       @default(0)
  positiveSignals      Int       @default(0)
  negativeSignals      Int       @default(0)
  lastActivityAt       DateTime?
  isPublic             Boolean   @default(false)
  scoreAt7dAgo         Float?
  coordinatedBoostFlag Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domainName])
  @@index([userId])
}

// Individual AIM events scoped to a domain (audit log for recalculation)
model DomainAimEvent {
  id                   String   @id @default(uuid())
  userId               String
  postId               Int?
  domainName           String
  eventType            String
  rawDelta             Float
  variableWeight       Float    @default(1.0)
  recencyFactor        Float    @default(1.0)
  contextWeight        Float    @default(1.0)
  confidenceMultiplier Float    @default(0.75)
  antiAbuseMultiplier  Float    @default(1.0)
  effectiveDelta       Float
  voterUserId          String?
  voterAimScore        Float?
  isReversed           Boolean  @default(false)
  createdAt            DateTime @default(now())
  // Same tamper-evidence hash concept as AimEvent.contentHash — computed
  // lazily, never at write time.
  contentHash          String?

  user      User  @relation("DomainEventOwner", fields: [userId], references: [id], onDelete: Cascade)
  post      Post? @relation(fields: [postId], references: [id], onDelete: SetNull)
  voterUser User? @relation("DomainEventVoter", fields: [voterUserId], references: [id], onDelete: SetNull)
  evidence  Evidence[]

  @@index([userId, domainName])
  @@index([postId])
}

model Event {
  id        Int      @id @default(autoincrement())
  type      String
  userId    String?
  payload   Json
  status    String   @default("pending")
  error     String?
  createdAt DateTime @default(now())
}

// Generic evidence file attached to an AimEvent, a DomainAimEvent, and/or a
// dispute (AimChallenge). New in MVP4, backing the Trust Receipt and
// Challenge screens. Exactly one of aimEventId / domainAimEventId /
// challengeId is expected to be set per row (enforced in the route layer,
// not the DB, so the schema stays flexible if a use case needs more than
// one link later).
model Evidence {
  id               String   @id @default(uuid())
  uploadedBy       String? // nullable — MVP5 machine-generated Evidence (outcomes,
                            // API responses) has no human uploader (Directive §8)
  aimEventId       String?
  domainAimEventId String?
  challengeId      String?
  fileName         String
  fileUrl          String
  fileType         String
  fileSize         Int
  status           String   @default("validated") // validated | pending | rejected
  createdAt        DateTime @default(now())

  uploader       User?           @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  aimEvent       AimEvent?       @relation(fields: [aimEventId], references: [id], onDelete: SetNull)
  domainAimEvent DomainAimEvent? @relation(fields: [domainAimEventId], references: [id], onDelete: SetNull)
  challenge      AimChallenge?   @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  // MVP5 — AIM Trust & Authority Layer extension (Architecture Alignment FINAL, §B).
  // All nullable; existing file-upload rows are unaffected. Plain indexed columns,
  // not enforced relations, matching how Claim/Decision cross-reference Evidence
  // in the ontology (see Signal/Decision/etc. below for the same convention).
  evidenceType            String?   // document | observation | api_response | attestation |
                                     // verified_claim | machine_event | human_verification |
                                     // policy_result | outcome
  provenance              Json?
  observedAt              DateTime?
  claimId                 String?
  decisionId              String?
  contentHash             String?   // Correction #7 — evidence integrity hash
  hashAlgorithm           String?
  canonicalizationVersion String?
  tenantId                String?   // set only for MVP5-submitted Evidence; null for existing rows
  content                 Json?     // the actual body for non-file evidence (attestations,
                                     // API responses, verified claims) submitted via POST /api/evidence

  @@index([aimEventId])
  @@index([domainAimEventId])
  @@index([challengeId])
  @@index([uploadedBy])
  @@index([claimId])
  @@index([decisionId])
  @@index([tenantId])
}

// ═══════════════════════════════════════════════════════════════════════════
// MVP5 — AIM TRUST & AUTHORITY LAYER
// Per "VERAXIUS AIM MVP5 — Architecture Alignment FINAL" (consolidates Directive
// v1.0 + Addendum v1.0 + Addendum v2.0, all ten corrections applied).
// Purely additive: no existing model above this line is touched. This layer
// extends the same AIM architecture — reliability, consistency, peer_validation,
// contradiction, decay — from measuring accumulated trust into governing
// consequential action through trust-derived authority. One AIM.
//
// Cross-cutting rule (Correction #3): every model below carries tenantId and is
// scoped to it; tenant isolation is enforced at the service layer on every read
// and write, not only via this column's presence.
// ═══════════════════════════════════════════════════════════════════════════

model Tenant {
  id         String   @id @default(uuid())
  name       String
  apiKeyHash String   @unique
  status     String   @default("active")
  metadata   Json?
  createdAt  DateTime @default(now())

  entities         Entity[]
  claims           Claim[]
  contradictions   Contradiction[]
  signals          Signal[]
  decisions        Decision[]
  trustStates      TrustState[]
  contexts         Context[]
  policies         Policy[]
  authorities      Authority[]
  humanApprovals   HumanApproval[]
  actions          Action[]
  outcomes         Outcome[]
  governanceEvents GovernanceEvent[]
}

// Unifies "who/what acted" across a member, an external AI agent, a partner
// organization, or a device — without duplicating identity for existing members.
model Entity {
  id           String   @id @default(uuid())
  tenantId     String
  entityType   String   // member | ai_agent | organization | device | system
  linkedUserId String?  // set when this Entity IS an existing member
  externalRef  String?  // e.g. "beaurity:partner:PTR-004", for non-member actors
  name         String?
  status       String   @default("active")
  metadata     Json?
  createdAt    DateTime @default(now())

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  linkedUser User?  @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([linkedUserId])
}

// An assertion, distinct from the evidence that supports or refutes it.
// status: PENDING | SUPPORTED | VERIFIED | CONTESTED | REFUTED | EXPIRED.
// "VERIFIED" can never be set solely by assertedByEntityId (Directive rule).
model Claim {
  id                 String    @id @default(uuid())
  tenantId           String
  subjectEntityId    String
  predicate          String
  objectValue        Json
  assertedByEntityId String?
  status             String    @default("pending")
  confidence         Float?
  contextId          String?
  assertedAt         DateTime  @default(now())
  expiresAt          DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([subjectEntityId])
}

// Correction #8 — a contradiction is structurally persistent, not only a flag
// inside TrustState.explanation. status: DETECTED | UNRESOLVED | CHALLENGED |
// RESOLVED | UPHELD.
model Contradiction {
  id                   String    @id @default(uuid())
  tenantId             String
  subjectEntityId      String
  claimId              String?
  evidenceIds          Json      // conflicting Evidence id set
  signalIds            Json?
  severity             Float
  status               String    @default("detected")
  detectedAt           DateTime  @default(now())
  resolvedAt           DateTime?
  resolutionEvidenceId String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([subjectEntityId])
  @@index([claimId])
}

// Same five dimensions as today's AIM. Decoupled from any per-user running
// score — this is the Trust Engine's own normalized input, separate from
// AimEvent (see aimAnatomy.ts's reliability/consistency/peer_validation/
// contradiction/decay taxonomy, reused as the vocabulary, not the table).
model Signal {
  id               String    @id @default(uuid())
  tenantId         String
  signalType       String
  dimension        String    // reliability | consistency | peer_validation | contradiction | decay
  sourceEntityId   String?
  sourceEvidenceId String?
  sourceOutcomeId  String?
  targetEntityId   String?
  targetClaimId    String?
  targetDecisionId String?
  direction        String    // positive | negative | neutral
  strength         Float
  confidence       Float
  observedAt       DateTime
  effectiveFrom    DateTime
  expiresAt        DateTime?
  operatorVersion  String?
  metadata         Json?
  decayModel       String?   // "exponential" — Directive §20; null = no decay beyond expiresAt
  halfLifeDays     Float?    // required when decayModel is set

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([targetEntityId])
  @@index([sourceEntityId])
}

// A proposed action awaiting evaluation before execution.
// status: CREATED | EVALUATING | DECIDED | EXECUTED | BLOCKED | ESCALATED | EXPIRED.
model Decision {
  id                 String   @id @default(uuid())
  tenantId           String
  proposedByEntityId String
  targetEntityId     String?
  decisionType       String
  proposedAction     String
  modelConfidence    Float?
  contextId          String?
  riskClass          String?
  payload            Json
  status             String   @default("created")
  idempotencyKey     String?  @unique // dedupes duplicate DECISION submission only —
                                       // see Action.idempotencyKey for execution safety
  createdAt          DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([proposedByEntityId])
  @@index([targetEntityId])
}

// One row per evaluation. Never overwritten, never a running total — a
// reevaluation always creates a new row (Correction #9). subjectEntityId is
// required (Correction #1): a TrustState must always answer "whose trust is
// this," never inferred indirectly through the Decision.
model TrustState {
  id                 String    @id @default(uuid())
  tenantId           String
  subjectEntityId    String
  decisionId         String
  contextId          String?
  trustScore         Float
  evidenceConfidence Float
  reliability        Float?
  consistency        Float?
  evidenceStrength   Float?
  peerValidation     Float?
  contradiction      Float?
  decay              Float?
  trustClass         String    // VERY_HIGH | HIGH | MODERATE | UNCERTAIN | LOW | CRITICAL
  evaluatedAt        DateTime  @default(now())
  validUntil         DateTime?
  engineVersion      String
  explanation        Json      // signals used, weights, contradictions, bootstrap contribution

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([subjectEntityId])
  @@index([decisionId])
}

model Context {
  id          String   @id @default(uuid())
  tenantId    String
  contextType String
  riskClass   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Correction #6 — immutable per version. A change is a new row
// (policyKey + incremented version), never an in-place edit of `rules`.
model Policy {
  id           String   @id @default(uuid())
  tenantId     String
  policyKey    String   // human-readable, e.g. "POL_PAYMENT_001"
  decisionType String
  version      String   // e.g. "1.0"
  rules        Json     // ordered condition → authority rules
  status       String   @default("active")
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, policyKey, version])
  @@index([tenantId])
}

// Correction #6 — policyVersion snapshotted at issuance (Policy rows are
// immutable, so this always answers "what exact policy authorized this?").
// Correction #4 — supersedesAuthorityId lets a human-approved executable
// Authority formally replace an escalated one, instead of mutating it.
// status: ISSUED | ACTIVE | CONSUMED | EXPIRED | REVOKED | RESOLVED.
model Authority {
  id                    String    @id @default(uuid())
  tenantId              String
  decisionId            String
  trustStateId          String
  policyId              String
  policyVersion         String
  authorityState        String    // EXECUTE | CONSTRAIN | CHALLENGE | ESCALATE | BLOCK
  permittedActions      Json?
  prohibitedActions     Json?
  constraints           Json?     // the Decision Envelope
  humanRequired         Boolean   @default(false)
  reasonCodes           Json?
  status                String    @default("issued")
  supersedesAuthorityId String?
  createdAt             DateTime  @default(now())
  expiresAt             DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([decisionId])
}

// Correction #4 — the formal event that converts an ESCALATE'd Authority into
// a new, executable one. Human review is never implicit.
model HumanApproval {
  id           String   @id @default(uuid())
  tenantId     String
  humanActorId String
  decisionId   String
  authorityId  String   // the ESCALATE'd Authority being resolved
  scope        Json?
  reason       String?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([authorityId])
}

// Correction #5 — execution idempotency lives here, not on Decision (one
// Decision can eventually permit more than one constrained operation).
model Action {
  id             String    @id @default(uuid())
  tenantId       String
  decisionId     String
  authorityId    String
  idempotencyKey String    @unique
  payloadHash    String
  actionType     String
  payload        Json
  status         String    @default("pending") // pending | executed | denied | failed
  executedAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([authorityId])
  @@index([decisionId])
}

model Outcome {
  id           String   @id @default(uuid())
  tenantId     String
  actionId     String
  outcomeType  String
  success      Boolean
  observations Json?
  status       String   @default("pending") // PENDING | OBSERVED | VERIFIED | DISPUTED | INGESTED
  observedAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([actionId])
}

// Hash-chained the same way AimEvent.contentHash already works today — SHA-256
// of the event's canonical fields, computed once, never mutated. Chained to
// the previous event's hash per correlationId for tamper evidence.
model GovernanceEvent {
  id                   String   @id @default(uuid())
  tenantId             String
  correlationId        String
  eventType            String
  entityId             String?
  decisionId           String?
  trustStateId         String?
  authorityId          String?
  actionId             String?
  outcomeId            String?
  evidenceIds          Json?
  signalIds            Json?
  contradictions       Json?
  rejectedAlternatives Json?
  policyId             String?
  policyVersion        String?
  trustEngineVersion   String?
  humanActorId         String?
  humanOverride        Boolean?
  eventPayload         Json
  previousHash         String?
  eventHash            String
  createdAt            DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([correlationId])
}
